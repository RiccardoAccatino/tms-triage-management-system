<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">

    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="Portale Segreteria" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>
        <Separator prefWidth="300.0" />
    </VBox>

    <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0">

        <Button maxWidth="Infinity" onAction="#ApriCalendarioGenerale" prefHeight="60.0" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 5;" text="Calendario Generale" />

        <Button maxWidth="Infinity" onAction="#AccettaTicket" prefHeight="60.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 5;" text="Accettazione Ticket" />

        <Button maxWidth="Infinity" onAction="#CreaNuovoTicket" prefHeight="60.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 5;" text="Crea Nuovo Ticket" />

    </VBox>

</VBox>
